{
  "name": "my-backend",
  "version": "1.0.0",
  "description": "Backend for my album review app",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start:dbserver": "node servers/dbserver.js",
    "start:server": "node servers/server.js",
    "start:musicserver": "node servers/musicbrainzserver.js",
    "start:tidalserver": "npm run start:musicserver",
    "start": "npm run start:server",
    "music": "npm run start:musicserver",
    "start:all": "concurrently \"npm run start:server\" \"npm run start:musicserver\"",
    "dev": "concurrently \"nodemon servers/server.js\" \"nodemon servers/musicbrainzserver.js\"",
    "test": "node --test tests/*.test.js",
    "check:music": "node scripts/check-musicbrainz.js"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.22.1",
    "mysql2": "^3.1.0",
    "pg": "^8.10.0",
    "concurrently": "^9.1.2"
  },
  "devDependencies": {}
}
